# Copy to .env and edit. Any LiteLLM model string works: https://docs.litellm.ai/docs/providers

# Local (default): needs Ollama running and the model pulled: `ollama pull qwen2.5:7b`
LLM_MODEL=ollama_chat/qwen2.5:7b
OLLAMA_API_BASE=http://localhost:11434

# Hosted providers: change LLM_MODEL and set the matching key, e.g.
# LLM_MODEL=anthropic/claude-opus-5-5
# ANTHROPIC_API_KEY=
# LLM_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=
# LLM_MODEL=gemini/gemini-2.0-flash
# GEMINI_API_KEY=

# Optional: custom OpenAI-compatible endpoint (vLLM, LM Studio, OpenRouter...)
# LLM_API_BASE=

LLM_TEMPERATURE=0.1
LLM_MAX_ITERATIONS=12
